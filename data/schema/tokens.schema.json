{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tokens.schema.json",
  "title": "Design tokens",
  "description": "data/design/tokens.json. The one record the site's colours, grid and motion come from, rendered to CSS by tools/tokens.mjs.",
  "type": "object",
  "required": [
    "version",
    "colour",
    "grid",
    "motion",
    "type"
  ],
  "properties": {
    "version": {
      "type": "integer"
    },
    "note": {
      "type": "string"
    },
    "colour": {
      "type": "object",
      "required": [
        "light",
        "dark",
        "plate",
        "pairs",
        "score"
      ],
      "properties": {
        "light": {
          "type": "object"
        },
        "dark": {
          "type": "object"
        },
        "plate": {
          "type": "object"
        },
        "roles": {
          "type": "object"
        },
        "pairs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "fg",
              "bg",
              "text"
            ],
            "properties": {
              "fg": {
                "type": "string"
              },
              "bg": {
                "type": "string"
              },
              "text": {
                "type": "boolean"
              }
            }
          }
        },
        "score": {
          "type": "object",
          "description": "One colour per scoring rule, composed in OKLCH from a shared lightness and one of two chromas so the hue is the only thing that differs. Decorative, never text, so no contrast pair measures them.",
          "required": [
            "light",
            "dark",
            "hue",
            "loud"
          ],
          "properties": {
            "note": {
              "type": "string"
            },
            "light": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            "dark": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            "hue": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            "loud": {
              "type": "array",
              "description": "Rules whose value actually differs between postings, measured rather than chosen. These take the full chroma; the rest recede.",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "type": {
      "type": "object",
      "description": "How the vendored families are set: the scale, the weights, the tracking and the leading. The families themselves are woff2 files declared in site/astro.config.mjs, per ADR-0011, because a family is a file rather than a value.",
      "additionalProperties": {
        "type": "string"
      }
    },
    "grid": {
      "type": "object"
    },
    "motion": {
      "type": "object",
      "required": [
        "tokens",
        "scroll"
      ],
      "properties": {
        "note": {
          "type": "string"
        },
        "tokens": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "default",
              "reduced",
              "used_by",
              "why"
            ],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-z-]+$"
              },
              "default": {
                "type": "string"
              },
              "reduced": {
                "type": "string"
              },
              "used_by": {
                "type": "string"
              },
              "why": {
                "type": "string"
              }
            }
          }
        },
        "scroll": {
          "type": "object",
          "required": [
            "default",
            "reduced"
          ]
        }
      }
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "rule",
          "enforcement"
        ],
        "properties": {
          "rule": {
            "type": "string"
          },
          "enforcement": {
            "type": "string"
          }
        }
      }
    }
  }
}
