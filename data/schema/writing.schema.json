{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "writing.schema.json",
  "title": "Writing post",
  "description": "Frontmatter of data/writing/<slug>.md. Technical posts in his voice; the body passes the letter profile of the voice lint, fenced code excepted.",
  "type": "object",
  "required": ["slug", "title", "date", "summary"],
  "additionalProperties": false,
  "properties": {
    "slug": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "title": { "type": "string" },
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "summary": { "type": "string", "description": "One sentence for the list" },
    "draft": { "type": "boolean", "default": false, "description": "Drafts build but do not list or route" },
    "linked_pipelines": { "type": "array", "items": { "type": "string" }, "default": [] }
  }
}
