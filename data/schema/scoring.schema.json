{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "scoring.schema.json",
  "title": "Search protocol, scoring config",
  "description": "Shape of data/scoring.json (public: gates, disqualifiers, deductions, score, piles, tuning) and of data/local/scoring.local.json (private: the comp numbers), merged at load. Structure is checked; the term lists are free.",
  "type": "object",
  "required": ["version", "gates", "disqualifiers", "deductions", "score", "piles", "proof_lead_by_tier", "status_values", "tuning"],
  "properties": {
    "version": { "type": "string" },
    "date": { "type": "string" },
    "status": { "type": "string" },
    "twin": { "type": "string" },
    "note": { "type": "string" },
    "candidate": { "type": "object" },
    "gates": {
      "type": "object",
      "required": ["remote", "comp"],
      "properties": {
        "remote": {
          "type": "object",
          "required": ["require_claim", "fail_claims", "fail_phrases", "fail_if_state_list_excludes", "flag_if_state_list_excludes_all_of", "flag_phrases", "ok_timezone_phrases", "nationwide_tokens"]
        },
        "comp": {
          "type": "object",
          "required": ["annualize_hourly_multiplier", "pass_min_annual", "flag_min_annual", "fail_below_annual", "hourly_floor", "unlisted_ok_if_tier_in", "unlisted_ok_if_size_over", "fail_phrases"],
          "properties": {
            "pass_min_annual": { "type": ["integer", "null"] },
            "flag_min_annual": { "type": ["integer", "null"] },
            "fail_below_annual": { "type": ["integer", "null"] },
            "hourly_floor": { "type": ["integer", "null"] }
          }
        }
      }
    },
    "disqualifiers": { "type": "object", "required": ["drop", "flag"] },
    "deductions": { "type": "object", "required": ["per_hit", "cap", "phrases"] },
    "score": {
      "type": "object",
      "required": ["remote", "comp", "intersection", "title", "company_tier", "freshness", "human"],
      "properties": {
        "comp": {
          "type": "object",
          "required": ["max", "bands", "unlisted_tier_1_3", "unlisted_size_over_200_no_tier", "flagged"],
          "properties": {
            "bands": {
              "type": "array",
              "items": { "type": "object", "required": ["midpoint_min", "points"], "properties": { "midpoint_min": { "type": "integer" }, "points": { "type": "integer" } } }
            }
          }
        }
      }
    },
    "discovery": {
      "type": "object",
      "properties": {
        "note": { "type": "string" },
        "require_any": { "type": "array", "items": { "type": "string" } },
        "exclude_title_patterns": { "type": "array", "items": { "type": "string" } },
        "generic_company_names": { "type": "array", "items": { "type": "string" } },
        "max_page_fetches": { "type": "integer" },
        "max_company_name_words": { "type": "integer" }
      }
    },
    "piles": { "type": "object", "required": ["apply_min", "review_min", "flagged_always_review", "apply_weekly_cap"] },
    "proof_lead_by_tier": { "type": "object" },
    "status_values": { "type": "array", "items": { "type": "string" } },
    "digest": { "type": "object" },
    "tuning": { "type": "object", "required": ["collect_only_until", "checkpoint", "never_loosen"] }
  }
}
