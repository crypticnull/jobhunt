// Cloudflare Workers static assets (ADR-0006). No Worker script, just the
// built site served from dist with clean URLs.
{
  "name": "portfolio",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
