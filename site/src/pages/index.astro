---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import Still from "../components/Still.astro";
import Mask from "../components/Mask.astro";
import { site } from "../site.config.mjs";

const byOrder = (a: { data: { order: number } }, b: { data: { order: number } }) => a.data.order - b.data.order;

const pipelines = (await getCollection("pipelines")).sort(byOrder);
const proof = (await getCollection("proof")).sort(byOrder);
const projects = (await getCollection("projects", (p) => p.data.featured && !p.data.archive)).sort(byOrder);
const writing = (await getCollection("writing", (w) => !w.data.draft)).sort((a, b) => b.data.date.localeCompare(a.data.date));

// A proof story that links projects is about the motion work and introduces
// that section. Everything else is a build. A build links to its pipeline page
// when one exists, else to its repo.
const pipelineFor = new Map(pipelines.map((p) => [p.data.linked_proof, p]));

// Scale, when a record carries an inventory. The total is summed here rather
// than written into the record, so the only thing anyone edits is the per
// category count and the arithmetic cannot disagree with itself. A manifest
// with no categories yet renders nothing at all.
const scaleOf = (p) => {
  const m = p.data.manifest;
  if (!m || !m.categories?.length) return null;
  const total = m.categories.reduce((sum, c) => sum + c.count, 0);
  return `${total} ${m.label} in ${m.categories.length} categories`;
};

const builds = proof
  .filter((p) => p.data.linked_projects.length === 0)
  .map((p) => {
    const pipe = pipelineFor.get(p.data.id);
    const source = p.data.repo ? "public repo" : "not yet public";
    return {
      id: p.data.id,
      title: p.data.title,
      summary: p.data.summary,
      href: pipe ? `/builds/${pipe.id}` : (p.data.repo ?? null),
      meta: [
        scaleOf(p),
        pipe ? pipe.data.kind : null,
        pipe && pipe.data.nodes ? `${pipe.data.nodes} nodes` : null,
        pipe ? null : source,
      ]
        .filter(Boolean)
        .join(" · "),
    };
  });
const workIntro = proof.find((p) => p.data.linked_projects.length > 0);
// A study is ready to show when its hero is a real still. Until the exports
// land the records carry an SVG placeholder, and a grid of dark tiles that say
// "hero still pending" costs more credibility than the work earns, so the
// section says what is true instead: the studies are being written and the
// builds above are live.
const ready = projects.filter((p) => p.data.hero.src.format !== "svg");
const waiting = projects.filter((p) => p.data.hero.src.format === "svg");
const ratio = (p) => `${p.data.hero.width} / ${p.data.hero.height}`;
---

<Layout>
  <section class="hero">
    <h1>{site.hero}</h1>
    <p class="sub">{site.sub}</p>
    <Mask
      label="Hero motion"
      need="Undecided. A looping clip, a still, or nothing at all. The sentence has to land in four seconds either way."
      ratio="21 / 9"
    />
  </section>

  <section id="builds">
    <h2>What I build</h2>
    <p class="lede">Tools and pipelines that run on my own hardware, built because the work needed them.</p>
    <ul class="cards">
      {
        builds.map((b) => (
          <li>
            {b.href ? (
              <a class="card" href={b.href}>
                <h3>{b.title}</h3>
                <p>{b.summary}</p>
                <span class="meta">{b.meta}</span>
              </a>
            ) : (
              <div class="card">
                <h3>{b.title}</h3>
                <p>{b.summary}</p>
                <span class="meta">{b.meta}</span>
              </div>
            )}
          </li>
        ))
      }
    </ul>
  </section>

  <section id="work">
    <h2>Selected work</h2>
    {workIntro && <p class="lede">{workIntro.data.summary}</p>}
    {ready.length === 0 && (
      <p class="pending live-only">
        The studies are being written and the stills arrive on their own schedule. The builds above are live, and the
        records so far are{" "}
        {projects.map((p, i) => (
          <>
            <a href={`/work/${p.id}`}>{p.data.title}</a>
            {i < projects.length - 1 ? ", " : "."}
          </>
        ))}
      </p>
    )}
    <ul class:list={["cards", "work-index", ready.length === 0 && "wire-only"]}>
      {
        waiting.map((p) => (
          <li class="wire-only">
            <a class="card work" href={`/work/${p.id}`}>
              <Mask label={p.data.title} need="Hero still" ratio={ratio(p)} />
              <div class="body">
                <h3>{p.data.title}</h3>
                <Mask label="Card summary" lines={2} />
                <span class="meta">
                  {p.data.year}
                  {p.data.franchise ? ` · ${p.data.franchise}` : ""}
                  {p.data.turnaround ? ` · ${p.data.turnaround}` : " · turnaround?"}
                </span>
              </div>
            </a>
          </li>
        ))
      }
      {
        ready.map((p) => (
          <li>
            <a class="card work" href={`/work/${p.id}`}>
              <Still still={p.data.hero} sizes="(min-width: 60rem) 22rem, 100vw" />
              <div class="body">
                <h3>{p.data.title}</h3>
                <p>{p.data.summary}</p>
                <span class="meta">
                  {p.data.year}
                  {p.data.franchise ? ` · ${p.data.franchise}` : ""}
                  {p.data.turnaround ? ` · ${p.data.turnaround}` : ""}
                </span>
              </div>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section id="writing">
    <h2>Writing</h2>
    <p class="lede">Technical posts. How the local pipeline works, why the job search polls ATS endpoints instead of scraping boards, and what this repo is as a case study.</p>
    {
      writing.length > 0 && (
        <ul class="cards">
          {writing.map((post) => (
            <li>
              <a class="card" href={`/writing/${post.id}`}>
                <h3>{post.data.title}</h3>
                <p>{post.data.summary}</p>
                <span class="meta">{post.data.date}</span>
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </section>

  <section id="about">
    <h2>About</h2>
    <p>
      I build the pipeline and I judge the frame that comes out of it, and ten years of senior motion and 3D work is
      where that judgment was earned. The motion side is production 3D in Cinema 4D with Redshift and
      Octane, compositing in After Effects, brand systems and event work carried across years. The software side is a
      commercial After Effects panel driven by a local language model, a hand-built generative video pipeline, and the
      tools that get all of it into a real workflow, written in Python, JavaScript and ExtendScript. I run it on my own
      workstation, and I care about asset management and metadata because the pipeline doesn't end at the render.
    </p>
    <p>{site.location}</p>
  </section>

  <section id="contact">
    <h2>Contact</h2>
    <p>
      <a href={site.github}>GitHub</a>
      {site.email && (
        <>
          <span aria-hidden="true"> · </span>
          <a href={`mailto:${site.email}`}>{site.email}</a>
        </>
      )}
    </p>
    {!site.email && <Mask label="Contact address" need="Waiting on the domain" lines={1} measure />}
  </section>
</Layout>
