---
import Layout from "../../layouts/Layout.astro";

// The four interactions the wireframe left open, each one running for real so
// the choice is made by feel rather than by description. Every option names
// the token it would claim, because deciding the interaction is also deciding
// which duration it spends, and two of the four durations in the record are
// currently documented and performed nowhere.
//
// Pick one per decision and the page writes the line to hand back.
const decisions = [
  {
    id: "hero",
    n: "A",
    title: "Hero entry",
    ask: "First paint. The sentence has four seconds to say what you are before a visitor files you as a motion designer. Motion can carry that or spend it.",
    options: [
      { id: "A0", name: "Cut", token: "none", note: "The sentence is there on the first frame. Fastest to read, and the most confident thing a page can do." },
      { id: "A1", picked: true, name: "Fade up", token: "--t-fade", note: "Eight pixels and an opacity ramp. Costs 160ms of reading time and buys a sense that the page arrived rather than appeared." },
      { id: "A2", name: "Rule, then text", token: "--t-slide then --t-fade", note: "A marker rule draws across, the sentence follows. Reads as drafting, which is the system's whole idea, but it is the slowest and it sequences." },
    ],
  },
  {
    id: "tile",
    n: "B",
    title: "Work tile to study",
    ask: "The click from the index into a study. The still is the same image on both pages, which is the one fact an interaction here can use.",
    options: [
      { id: "B0", name: "Plain", token: "none", note: "A navigation. Nothing to maintain, nothing to go wrong on a slow connection." },
      { id: "B1", picked: true, name: "Press", token: "--t-quick", note: "The tile acknowledges the press and nothing else. Cheap, and it is the part people actually notice." },
      { id: "B2", name: "The still holds", token: "--t-fade", note: "The image persists across the navigation and the rest of the page changes around it. The strongest signal of craft here, and the only option with a real failure mode." },
    ],
  },
  {
    id: "still",
    n: "C",
    title: "Still to full size",
    ask: "Boards and styleframes are the proof, and a 20rem grid tile is not where anyone judges a frame. This one matters more than it looks.",
    options: [
      { id: "C0", name: "Nothing", token: "none", note: "The grid is the whole experience. Honest, and it wastes the process material the studies are built around." },
      { id: "C1", name: "Dialog", token: "--t-fade", note: "Native dialog, backdrop, escape closes it, focus returns. The accessible answer with the least code." },
      { id: "C2", picked: true, name: "Grows from the tile", token: "--t-fade", note: "The frame scales up from where it sat. Better sense of place, more to get wrong on a phone." },
    ],
  },
  {
    id: "register",
    n: "E",
    title: "Misregistration",
    ask: "A press out of register prints the plates a hair apart and leaves a coloured fringe beside the type. Per word, on hover, so the page answers where the eye is rather than everywhere at once. The offset takes --t-slide, a cut under reduce, and the tint takes --t-fade.",
    options: [
      { id: "E1", name: "One fringe", token: "--t-slide, --t-fade", note: "A marker ghost slides right off the true impression. Reads as a hover glow rather than as a press fault." },
      { id: "E2", picked: true, name: "Full misregistration", token: "--t-slide, --t-fade", note: "Marker one way, blueprint the other, which is what a four colour press actually does when it slips. On the builds list now, and it spends the second accent colour, which otherwise does almost nothing here." },
      { id: "E3", name: "The pair separates", token: "--t-slide, --t-fade", note: "The ghost goes one way and the word itself moves a hair the other. Reads as the sheet shifting rather than as ink smearing, and it is the only one that moves the text you are reading." },
    ],
  },
  {
    id: "dot",
    n: "D",
    title: "The recording dot",
    ask: "The token record declares --t-blink for a dot that marks a clip playing. Nothing on the site performs it.",
    options: [
      { id: "D0", name: "Drop it", token: "removes --t-blink", note: "The record stops documenting a movement the product does not have." },
      { id: "D1", picked: true, name: "Build it", token: "--t-blink", note: "A marker dot beside a playing clip. One more moving thing on a page whose job is to be read." },
    ],
  },
];

// Each specimen answers the trigger the real interaction answers, so the hint
// says which one. There is no play button: a movement you watch and a movement
// you caused do not feel the same, and only one of them is the thing being
// decided here.
const HINTS = {
  hero: "press to replay",
  tile: "press and hold",
  still: "click to open",
  dot: "click to play",
  register: "hover the words",
};
---

<Layout title="Motion lab" description="The four open interaction decisions, running, so the choice is made by feel." noindex>
  <h1>Motion lab</h1>
  <p class="lede">
    Four interactions the wireframe left open. Each option runs here for real, on the same tokens the site uses, so
    turning motion down in the footer turns these down too and you can check the reduced column is a page that still
    works rather than a page that lost something.
  </p>
  <p class="prose">
    Nothing plays on its own. Each specimen answers the trigger the real interaction answers, because a movement you
    watch and a movement you caused do not feel the same and only one of them is the thing being decided. Pick one per
    decision and the line at the bottom is the answer to hand back. <a href="/wire">The slot inventory</a>
    is next door, and <a href="/system">the token record</a> holds the durations themselves.
  </p>

  {
    decisions.map((d) => (
      <section class="dec" id={d.id}>
        <h2><span class="n">{d.n}</span> {d.title}</h2>
        <p class="ask">{d.ask}</p>
        <ul class="opts">
          {d.options.map((o) => (
            <li>
              <div class:list={["stage", d.id !== "register" && "tappable"]} data-stage={o.id} data-kind={d.id} role={d.id === "register" ? undefined : "button"} tabindex={d.id === "register" ? undefined : 0}>
                <div class="specimen" data-spec={o.id}>
                  {d.id === "hero" && (
                    <>
                      <span class="rule" />
                      <strong>I realize visions, and build the pipelines that do the work.</strong>
                      <em>Production 3D and generative video running locally.</em>
                    </>
                  )}
                  {d.id === "tile" && (
                    <>
                      <span class="tile" />
                      <span class="tile-meta">Quest 2025</span>
                    </>
                  )}
                  {d.id === "still" && (
                    <>
                      <span class="thumb" />
                      <span class="sheet" />
                    </>
                  )}
                  {d.id === "register" && (
                    <span class={`reg ${o.id}`}>
                      <span class="w"><span class="ghost b" aria-hidden="true">Keynote</span><span class="ghost m" aria-hidden="true">Keynote</span>Keynote</span>{" "}
                      <span class="w"><span class="ghost b" aria-hidden="true">extractor</span><span class="ghost m" aria-hidden="true">extractor</span>extractor</span>
                    </span>
                  )}
                  {d.id === "dot" && (
                    <>
                      <span class="dot" />
                      <span class="tile-meta">Playing</span>
                    </>
                  )}
                </div>
              </div>
              <div class="opt-head">
                <label>
                  <input type="radio" name={d.id} value={o.id} />
                  <span class="opt-id">{o.id}</span> {o.name}
                  {o.picked && <span class="shipped">shipped</span>}
                </label>
                <span class="hint">{HINTS[d.id]}</span>
              </div>
              <p class="token">{o.token}</p>
              <p class="note">{o.note}</p>
            </li>
          ))}
        </ul>
      </section>
    ))
  }

  <aside class="dials" aria-label="Dials">
    <div class="dial-head">
      <strong>Dials</strong>
      <span class="hint">live, this browser only</span>
      <button type="button" id="dial-reset">Reset</button>
    </div>
    <div class="dial-grid">
      {[
        { v: "t-quick", label: "quick", min: 0, max: 600, step: 10, unit: "ms" },
        { v: "t-fade", label: "fade", min: 0, max: 600, step: 10, unit: "ms" },
        { v: "t-slide", label: "slide", min: 0, max: 900, step: 10, unit: "ms" },
        { v: "t-blink", label: "blink", min: 200, max: 3000, step: 50, unit: "ms" },
        { v: "slip-x", label: "slip", min: 0, max: 0.6, step: 0.01, unit: "em" },
        { v: "rise-y", label: "rise", min: 0, max: 2, step: 0.05, unit: "rem" },
        { v: "press", label: "press", min: 0.9, max: 1, step: 0.005, unit: "" },
      ].map((d) => (
        <label class="dial">
          <span class="dial-name">{d.label}</span>
          <input type="range" data-var={d.v} data-unit={d.unit} min={d.min} max={d.max} step={d.step} />
          <output data-out={d.v} />
        </label>
      ))}
      <label class="dial ease">
        <span class="dial-name">ease out</span>
        <span class="bez">
          {["x1", "y1", "x2", "y2"].map((k) => (
            <input type="number" data-bez={k} min="-1" max="2" step="0.05" />
          ))}
        </span>
        <output data-out="ease-out" />
      </label>
    </div>
    <p class="patch-note">The record patch, for <code>data/design/tokens.json</code>. Paste it back and it becomes the site.</p>
    <pre class="patch" id="patch">Nothing changed yet.</pre>
  </aside>

  <section class="dec" id="answer">
    <h2><span class="n">E</span> The answer</h2>
    <p class="ask">Four picks, one line. Nothing here is saved anywhere but this browser.</p>
    <p class="picked" id="picked" aria-live="polite">Nothing picked yet.</p>
  </section>
</Layout>

<script>
  // Same rule as the system page: one movement per press, nothing plays on
  // load or on scroll, and the token the option names is the token the
  // specimen runs, so the reduced column is what a visitor who asked for less
  // motion actually receives.
  // Loop rather than one shot, because the point is to turn a dial while the
  // movement is running and watch it change. Press again to stop.
  // The specimen is the control. Nothing plays on its own, because a movement
  // you watch and a movement you caused do not feel the same and only one of
  // them is the thing being decided. Press replays what loads, press and hold
  // is the press, click opens and closes what opens and closes, click starts
  // and stops what plays. Hover needs nothing at all.
  for (const stage of document.querySelectorAll<HTMLElement>(".stage.tappable")) {
    const kind = stage.dataset.kind;
    const spec = stage.querySelector<HTMLElement>("[data-spec]");
    if (!spec) continue;
    const fire = () => {
      if (kind === "hero") {
        spec.classList.remove("run");
        void spec.offsetWidth;
        spec.classList.add("run");
      } else if (kind === "still") {
        spec.classList.toggle("open");
      } else if (kind === "dot") {
        spec.classList.toggle("playing");
      } else if (kind === "tile") {
        spec.classList.toggle("gone");
      }
    };
    stage.addEventListener("click", fire);
    stage.addEventListener("keydown", (e) => {
      if (e.key === "Enter" || e.key === " ") {
        e.preventDefault();
        fire();
      }
    });
  }

  // The dials write straight onto the root, so every specimen and the rest of
  // the site change under them at once. Nothing is saved to the record from
  // here: the panel prints the patch and Matt decides whether it ships.
  const rootEl = document.documentElement;
  const base: Record<string, string> = {};
  const now: Record<string, string> = {};
  const readBase = (v: string) => getComputedStyle(rootEl).getPropertyValue(`--${v}`).trim();
  const bez = Array.from(document.querySelectorAll<HTMLInputElement>("input[data-bez]"));
  const patch = document.getElementById("patch");

  const paintPatch = () => {
    const changed = Object.keys(now).filter((k) => now[k] !== base[k]);
    if (!patch) return;
    if (!changed.length) {
      patch.textContent = "Nothing changed yet.";
      return;
    }
    patch.textContent = changed
      .map((k) => `  { "name": "${k}", "default": "${now[k]}" }`)
      .join(",\n");
  };

  const setVar = (v: string, value: string) => {
    now[v] = value;
    rootEl.style.setProperty(`--${v}`, value);
    const out = document.querySelector<HTMLOutputElement>(`output[data-out="${v}"]`);
    if (out) out.textContent = value;
    paintPatch();
  };

  for (const r of document.querySelectorAll<HTMLInputElement>("input[data-var]")) {
    const v = r.dataset.var!;
    const unit = r.dataset.unit ?? "";
    base[v] = readBase(v);
    now[v] = base[v];
    r.value = String(parseFloat(base[v]));
    const out = document.querySelector<HTMLOutputElement>(`output[data-out="${v}"]`);
    if (out) out.textContent = base[v];
    r.addEventListener("input", () => setVar(v, `${r.value}${unit}`));
  }

  // check-tokens-allow: easing curve, because this panel authors a curve from
  // four numbers a person is turning rather than consuming one, and a lab that
  // cannot write the thing it is for is not a lab. Nothing here reaches the
  // record: the panel prints a patch and Matt decides.
  base["ease-out"] = readBase("ease-out");
  now["ease-out"] = base["ease-out"];
  const nums = base["ease-out"].match(/-?[\d.]+/g) || ["0.2", "0", "0", "1"];
  bez.forEach((input, i) => {
    input.value = nums[i] ?? "0";
    input.addEventListener("input", () => {
      const v = `cubic-bezier(${bez.map((b) => b.value || "0").join(", ")})`;
      setVar("ease-out", v);
    });
  });
  const easeOut = document.querySelector<HTMLOutputElement>('output[data-out="ease-out"]');
  if (easeOut) easeOut.textContent = base["ease-out"];

  document.getElementById("dial-reset")?.addEventListener("click", () => {
    for (const k of Object.keys(now)) {
      rootEl.style.removeProperty(`--${k}`);
      now[k] = base[k];
      const out = document.querySelector<HTMLOutputElement>(`output[data-out="${k}"]`);
      if (out) out.textContent = base[k];
    }
    for (const r of document.querySelectorAll<HTMLInputElement>("input[data-var]")) {
      r.value = String(parseFloat(base[r.dataset.var!]));
    }
    bez.forEach((b, i) => (b.value = nums[i] ?? "0"));
    paintPatch();
  });
  const out = document.getElementById("picked");
  const KEY = "motion-picks";
  const picks: Record<string, string> = (() => {
    try { return JSON.parse(localStorage.getItem(KEY) || "{}"); } catch { return {}; }
  })();
  const order = ["hero", "tile", "still", "register", "dot"];
  const paint = () => {
    const line = order.map((k) => picks[k]).filter(Boolean);
    if (out) out.textContent = line.length ? line.join(" ") : "Nothing picked yet.";
  };
  for (const r of document.querySelectorAll<HTMLInputElement>('input[type="radio"]')) {
    if (picks[r.name] === r.value) r.checked = true;
    r.addEventListener("change", () => {
      picks[r.name] = r.value;
      try { localStorage.setItem(KEY, JSON.stringify(picks)); } catch {}
      paint();
    });
  }
  paint();
</script>

<style>
  .dec {
    border-top: 1px solid var(--rule);
    padding-top: 1.5rem;
    margin: 3.5rem 0 0;
  }
  .dec .n {
    font-family: var(--mono);
    color: var(--muted);
    font-size: 0.8em;
    margin-right: 0.5rem;
  }
  .ask {
    max-width: var(--measure);
    color: var(--muted);
  }
  .opts {
    list-style: none;
    margin: 2rem 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
    gap: 2rem var(--grid-gap);
  }
  /* A fixed box per specimen, so a movement never reflows the page around it
     and the three options can be compared without anything jumping. */
  .stage {
    height: 8.5rem;
    border: 1px solid var(--rule);
    background: var(--field);
    display: grid;
    place-items: center;
    padding: 1rem;
    overflow: hidden;
  }
  .specimen {
    display: grid;
    justify-items: center;
    gap: 0.4rem;
    text-align: center;
    width: 100%;
  }
  .specimen strong {
    font-family: var(--font-display);
    font-size: 0.92rem;
    line-height: 1.25;
    font-weight: 600;
  }
  .specimen em {
    font-size: 0.75rem;
    color: var(--muted);
    font-style: normal;
  }
  .specimen .rule {
    height: 2px;
    width: 100%;
    background: var(--marker);
    transform-origin: left;
  }
  .specimen .tile {
    width: 100%;
    aspect-ratio: 16 / 9;
    background: var(--rule);
  }
  .specimen .tile-meta {
    font-family: var(--mono);
    font-size: 0.68rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .specimen .thumb {
    width: 4rem;
    aspect-ratio: 16 / 9;
    background: var(--rule);
  }
  .specimen .sheet {
    position: absolute;
    inset: 1rem;
    background: var(--plate);
    opacity: 0;
    pointer-events: none;
  }
  .stage {
    position: relative;
  }
  .specimen .dot {
    width: 0.6rem;
    height: 0.6rem;
    border-radius: 50%;
    background: var(--marker);
  }

  /* ---- The options, each running the token it names --------------------- */

  /* A0, B0, C0, D0 do nothing on purpose, and there is no rule for them. */

  [data-spec="A1"].run strong,
  [data-spec="A1"].run em {
    animation: rise var(--t-fade) var(--ease-out) both;
  }
  [data-spec="A1"].run em {
    animation-delay: var(--t-quick);
  }
  [data-spec="A1"] .rule {
    visibility: hidden;
  }

  [data-spec="A2"] .rule {
    transform: scaleX(0);
  }
  [data-spec="A2"].run .rule {
    animation: draw var(--t-slide) var(--ease-out) both;
  }
  [data-spec="A2"].run strong,
  [data-spec="A2"].run em {
    animation: rise var(--t-fade) var(--ease-out) both;
    animation-delay: var(--t-slide);
  }

  [data-spec="A0"] .rule {
    visibility: hidden;
  }

  /* B1 is the press itself. Holding the mouse down holds the scale, which is
     the whole point and the one thing an autoplayer could never show. */
  [data-spec="B1"] .tile {
    transition: transform var(--t-quick) var(--ease-out);
  }
  .stage:active [data-spec="B1"] .tile {
    transform: scale(var(--press));
  }
  /* B2 is the still carrying across a navigation, so it latches rather than
     springing back. Click again to send it home. */
  [data-spec="B2"] .tile {
    transition: transform var(--t-fade) var(--ease-out);
  }
  [data-spec="B2"] .tile-meta {
    transition: opacity var(--t-fade) var(--ease-in);
  }
  [data-spec="B2"].gone .tile {
    transform: scale(1.35);
  }
  [data-spec="B2"].gone .tile-meta {
    opacity: 0;
  }

  .specimen .sheet {
    transition:
      opacity var(--t-fade) var(--ease-out),
      transform var(--t-fade) var(--ease-out);
  }
  [data-spec="C1"].open .sheet {
    opacity: 0.92;
  }
  /* C2 grows from where the thumbnail sits, which is why the origin is the
     corner it started in rather than the middle of the sheet. */
  [data-spec="C2"] .sheet {
    transform-origin: 20% 50%;
    transform: scale(0.2);
  }
  [data-spec="C2"].open .sheet {
    opacity: 0.92;
    transform: scale(1);
  }

  .specimen .dot {
    opacity: 0.15;
  }
  .specimen.playing .dot {
    opacity: 1;
  }
  [data-spec="D1"].playing .dot {
    animation: blink var(--t-blink) steps(2, jump-none) infinite alternate;
  }
  .specimen .tile-meta {
    opacity: 0.4;
  }
  .specimen.playing .tile-meta {
    opacity: 1;
  }

  @keyframes rise {
    from { opacity: 0; transform: translateY(var(--rise-y)); }
    to { opacity: 1; transform: none; }
  }
  @keyframes draw {
    from { transform: scaleX(0); }
    to { transform: scaleX(1); }
  }
  }
  }
  }
  @keyframes blink {
    from { opacity: 1; }
    to { opacity: 0.15; }
  }

  /* Loop turns a one shot into something a dial can be turned against.

     !important, and it earns it. Every option sets its movement with the
     animation shorthand, which resets iteration-count and direction as a side
     effect, and those selectors carry an attribute plus a class plus an
     element, so they outrank anything this rule can say without it. The
     alternative is repeating the override once per option, which is the same
     override written eleven times and one more thing to forget when a
     twelfth option lands. */
  /* The stage is the control, so it has to say so. */
  .stage.tappable {
    cursor: pointer;
    user-select: none;
  }
  .stage.tappable:focus-visible {
    outline: 2px solid var(--marker);
    outline-offset: 2px;
  }

  /* Hover a word to run the variant by hand, or press Loop and it runs on its
     own. The hover is a transition and the loop is an animation, because a
     transition has nothing to repeat. */
  .reg {
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 600;
  }
  .reg .w {
    position: relative;
    display: inline-block;
  }
  .reg .ghost {
    position: absolute;
    inset: 0;
    z-index: -1;
    opacity: 0;
    transform: translateX(0);
    pointer-events: none;
    transition:
      transform var(--t-slide) var(--ease-out),
      opacity var(--t-fade) var(--ease-out);
  }
  .reg .ghost.m {
    color: var(--marker);
  }
  .reg .ghost.b {
    color: var(--blueprint);
  }
  .reg .w {
    transition: transform var(--t-slide) var(--ease-out);
  }
  /* E1, one fringe. The blueprint plate never prints. */
  .reg.E1 .ghost.b {
    display: none;
  }
  .reg.E1 .w:hover .ghost.m {
    opacity: 1;
    transform: translateX(var(--slip-x));
  }
  /* E2, both plates slip, opposite ways. What ships. */
  .reg.E2 .w:hover .ghost.m {
    opacity: 1;
    transform: translateX(var(--slip-x));
  }
  .reg.E2 .w:hover .ghost.b {
    opacity: 1;
    transform: translateX(calc(var(--slip-x) * -1));
  }
  /* E3, the sheet shifts: the word moves too. */
  .reg.E3 .ghost.b {
    display: none;
  }
  .reg.E3 .w:hover .ghost.m {
    opacity: 1;
    transform: translateX(calc(var(--slip-x) * 1.4));
  }
  .reg.E3 .w:hover {
    transform: translateX(calc(var(--slip-x) * -0.4));
  }

  /* Hover is the whole interaction here, so there is nothing to add. The
     keyframes the loop needed are gone with it. */

  .shipped {
    font-family: var(--mono);
    font-size: 0.62rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--blueprint);
    margin-left: 0.4rem;
  }
  .opt-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin: 0.75rem 0 0.25rem;
  }
  .opt-head label {
    font-size: 0.9rem;
    cursor: pointer;
  }
  .opt-id {
    font-family: var(--mono);
    font-size: 0.72rem;
    color: var(--marker);
    letter-spacing: 0.06em;
  }
  .opt-head button {
    font-family: var(--mono);
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink);
    background: transparent;
    border: 1px solid var(--rule);
    padding: 0.25rem 0.6rem;
