---
import { getCollection, render } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import Still from "../../components/Still.astro";
import Video from "../../components/Video.astro";
import ChapterRail from "../../components/ChapterRail.astro";
import Mask from "../../components/Mask.astro";
import Lightbox from "../../components/Lightbox.astro";
import { CHAPTER_ORDER } from "../../schemas.mjs";

export async function getStaticPaths() {
  const projects = await getCollection("projects");
  const chapters = await getCollection("chapters");
  return projects.map((entry) => ({
    params: { slug: entry.id },
    props: { entry, chapters: chapters.filter((c) => c.data.project === entry.id) },
  }));
}

const { entry, chapters } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);

// Kind decides the sequence, not the file name, so a study cannot end up in a
// different order from the one beside it. Final leads and the process follows.
const rank = new Map(CHAPTER_ORDER.map((k, i) => [k, i]));
const ordered = [...chapters].sort(
  (a, b) => rank.get(a.data.kind) - rank.get(b.data.kind) || a.data.order - b.data.order,
);
const rendered = await Promise.all(
  ordered.map(async (c) => ({ data: c.data, anchor: c.data.kind, Body: (await render(c)).Content })),
);

const kinds = ["storyboard", "styleframe", "wip", "breakdown"] as const;
const labels = { storyboard: "Storyboards", styleframe: "Styleframes", wip: "In progress", breakdown: "Breakdown" };

// What this study is still waiting for. The page renders the finished shape in
// wire mode so the reading order, the rail and the motion can be judged before
// a single asset exists, and every box here goes away on its own the day the
// record behind it lands.
const CHAPTER_LABELS = { final: "Final", brief: "Brief", boards: "Boards", frames: "Styleframes", build: "Build", delivery: "Delivery" };
const have = new Set(rendered.map((c) => c.data.kind));
const absent = CHAPTER_ORDER.filter((k) => !have.has(k));
const heroPending = d.hero.src.format === "svg";
const noVideo = !d.video || d.video.provider === "none";
const videoRatio = d.video ? `${d.video.width} / ${d.video.height}` : "16 / 9";
---

<Layout title={d.title} description={d.summary}>
  <a class="back" href="/#work">All work</a>
  <h1>{d.title}</h1>
  <p class="lede">{d.summary}</p>

  {
    !noVideo ? (
      <Video video={d.video} poster={d.hero} title={d.title} />
    ) : heroPending ? (
      <Mask label="Final film" need="Export plus a poster frame, or a hero still if there is no film" ratio={videoRatio} />
    ) : (
      <figure class="frame">
        <Still still={d.hero} loading="eager" />
      </figure>
    )
  }

  <dl class="facts">
    <dt>Year</dt>
    <dd>{d.year}</dd>
    {d.franchise && (
      <>
        <dt>Franchise</dt>
        <dd>{d.franchise}</dd>
      </>
    )}
    <dt>Client</dt>
    <dd>{d.client}</dd>
    <dt>Role</dt>
    <dd>{d.role}</dd>
    <dt>Discipline</dt>
    <dd>{d.disciplines.join(", ")}</dd>
    {d.tools.length > 0 ? (
      <>
        <dt>Tools</dt>
        <dd>{d.tools.join(", ")}</dd>
      </>
    ) : (
      <>
        <dt class="wire-only">Tools</dt>
        <dd class="wire-only"><Mask label="Tools" need="The list" lines={1} /></dd>
      </>
    )}
    {d.turnaround ? (
      <>
        <dt>Turnaround</dt>
        <dd>{d.turnaround}</dd>
      </>
    ) : (
      <>
        <dt class="wire-only">Turnaround</dt>
        <dd class="wire-only"><Mask label="Turnaround" need="Only where it is impressive" lines={1} /></dd>
      </>
    )}
  </dl>

  <ChapterRail present={rendered.map((c) => ({ kind: c.data.kind, title: c.data.title, anchor: c.anchor }))} />

  <div class="prose">
    <Content />
  </div>

  {
    rendered.map(({ data, anchor, Body }) => (
      <section class="chapter" id={anchor}>
        <h2>{data.title}</h2>
        {data.caption && <p class="lede">{data.caption}</p>}
        <div class="prose">
          <Body />
        </div>
      </section>
    ))
  }

  {
    absent.map((kind) => (
      <section class="chapter wire-only" id={kind}>
        <h2>{CHAPTER_LABELS[kind]}</h2>
        <Mask label={`${CHAPTER_LABELS[kind]} chapter`} need={`data/projects/${entry.id}/chapters/*-${kind}.md`} lines={4} measure />
      </section>
    ))
  }

  {
    d.stills.length > 0 ? (
      <>
        <h2>Stills</h2>
        <ul class="grid">
          {d.stills.map((s) => (
            <li>
              <button type="button" data-zoom>
                <Still still={s} sizes="(min-width: 60rem) 20rem, 100vw" />
              </button>
            </li>
          ))}
        </ul>
      </>
    ) : (
      <div class="wire-only">
        <h2>Stills</h2>
        <ul class="grid">
          {[0, 1, 2].map(() => (
            <li>
              <Mask label="Still" need="Exports" ratio="16 / 9" />
            </li>
          ))}
        </ul>
      </div>
    )
  }

  {
    kinds.map((kind) => {
      const items = d.process.filter((p) => p.kind === kind);
      if (items.length === 0)
        return (
          <div class="wire-only">
            <h2>{labels[kind]}</h2>
            <ul class="grid">
              {[0, 1, 2].map(() => (
                <li>
                  <Mask label={labels[kind]} need="Process material" ratio="16 / 9" />
                </li>
              ))}
            </ul>
          </div>
        );
      return (
        items.length > 0 && (
          <>
            <h2>{labels[kind]}</h2>
            <ul class="grid">
              {items.map((p) => (
                <li>
                  <figure>
                    <button type="button" data-zoom>
                      <Still still={p} sizes="(min-width: 60rem) 20rem, 100vw" />
                    </button>
                    {p.caption && <figcaption>{p.caption}</figcaption>}
                  </figure>
                </li>
              ))}
            </ul>
          </>
        )
      );
    })
  }

  <Lightbox />
</Layout>
