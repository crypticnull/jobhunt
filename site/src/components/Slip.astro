---
// Misregistration, ramped from the pointer.
//
// When a press runs out of register the plates print a hair apart and you get
// a coloured fringe beside the type. This is that, on purpose and on hover.
//
// Two rules make it read as one printed thing rather than a row of separate
// effects. The slip is a group move: every ghost in the line travels the same
// distance at the same moment, because a press does not slip one word at a
// time. And the fringe fades with distance from the pointer, across a band
// wider than any single word, so the line answers where the eye is without
// anything jumping. Nothing moves toward the reader and nothing moves apart.
// It is one flat sheet, printed slightly wrong, brightest where you are
// looking.
//
// The true word is the last child and positioned, so it paints over its own
// ghosts without any of them needing a negative z-index. The earlier version
// used z-index -1, which put the fringe behind the page background, where it
// was computed on every hover and visible to nobody.
interface Props {
  text: string;
  tag?: string;
}
const { text, tag = "span" } = Astro.props;
const Tag = tag as any;
const words = text.split(/(\s+)/);
---

<Tag class="slip" data-slip>
  {
    words.map((w) =>
      w.trim() === "" ? (
        w
      ) : (
        <span class="w">
          <span class="ghost b" aria-hidden="true">{w}</span>
          <span class="ghost m" aria-hidden="true">{w}</span>
          <span class="true">{w}</span>
        </span>
      ),
    )
  }
</Tag>
