---
// Misregistration, per word.
//
// When a press runs out of register the plates print a hair apart and you get
// a coloured fringe beside the type. This is that, on purpose and on hover:
// each word carries a ghost of itself in marker, and pointing at the word
// slides the ghost off the true impression.
//
// The unit is the word rather than the line, so the page responds exactly
// where you are looking rather than everywhere at once. It is split at build
// time and the ghost is a real element marked aria-hidden, so nothing is
// announced twice and nothing depends on generated content being ignored.
//
// Motion: the offset takes --t-slide, which is a cut under reduce, so a
// visitor who asked for less motion gets the fringe without the travel. The
// tint takes --t-fade, because opacity is not the part that makes anyone ill.
interface Props {
  text: string;
  tag?: string;
}
const { text, tag = "span" } = Astro.props;
const Tag = tag as any;
const words = text.split(/(\s+)/);
---

<Tag class="slip">
  {words.map((w) => (w.trim() === "" ? w : <span class="w"><span class="ghost" aria-hidden="true">{w}</span>{w}</span>))}
</Tag>
