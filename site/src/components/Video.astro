---
// Host-agnostic player. provider none renders the poster still only. Any real
// provider renders a native video element with a local poster, preload none,
// inside a box whose aspect ratio is fixed from the record, so nothing shifts
// when the player or the stream arrives.
import Still from "./Still.astro";

interface Props {
  video: {
    provider: string;
    mp4: string[];
    hls?: string | null;
    poster?: string | null;
    width: number;
    height: number;
  };
  poster: { src: ImageMetadata; width: number; height: number; alt: string };
  title: string;
}

const { video, poster, title } = Astro.props;
const playable = video.provider !== "none" && (video.mp4.length > 0 || video.hls);
const ratio = `${video.width} / ${video.height}`;
---

<figure class="frame has-dot" style={`aspect-ratio: ${ratio}`}>
  <span class="rec" aria-hidden="true" hidden></span>
  {
    playable ? (
      <video controls playsinline preload="none" width={video.width} height={video.height} poster={poster.src.src} aria-label={title}>
        {video.mp4.map((src) => (
          <source src={src} type="video/mp4" />
        ))}
        {video.hls && <source src={video.hls} type="application/vnd.apple.mpegurl" />}
        <Still still={poster} />
      </video>
    ) : (
      <Still still={poster} loading="eager" />
    )
  }
</figure>

<script>
  // D1. The dot marks a clip that is running, and nothing else on the page
  // moves on its own, so it is the one thing that says "this is playing"
  // without a chrome overlay. --t-blink is 0ms under reduce, which stops the
  // blink and leaves the dot lit, which is still the right answer.
  for (const fig of document.querySelectorAll<HTMLElement>("figure.has-dot")) {
    const v = fig.querySelector("video");
    const dot = fig.querySelector<HTMLElement>(".rec");
    if (!v || !dot) continue;
    v.addEventListener("play", () => (dot.hidden = false));
    for (const e of ["pause", "ended", "emptied"]) v.addEventListener(e, () => (dot.hidden = true));
  }
</script>

<style>
  .frame.has-dot {
    position: relative;
  }
  .rec {
    position: absolute;
    top: var(--grid-gap);
    left: var(--grid-gap);
    z-index: 1;
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    background: var(--marker);
    animation: rec-blink var(--t-blink) steps(2, jump-none) infinite;
    pointer-events: none;
  }
  @keyframes rec-blink {
    from {
      opacity: 1;
    }
    to {
      opacity: 0.2;
    }
  }
</style>
