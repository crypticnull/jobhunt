---
// The chapter index for a study. Chapters that do not exist yet are shown
// struck through rather than hidden, which is the honest version: a reader can
// see the shape of a finished study and see what this one is still missing,
// and Matt can ship a project before every chapter is written.
import { CHAPTER_ORDER } from "../schemas.mjs";

const LABELS = {
  final: "Final",
  brief: "Brief",
  boards: "Boards",
  frames: "Styleframes",
  build: "Build",
  delivery: "Delivery",
};

interface Props {
  present: { kind: string; title: string; anchor: string }[];
}

const { present } = Astro.props;
const byKind = new Map(present.map((c) => [c.kind, c]));
const missing = CHAPTER_ORDER.filter((k) => !byKind.has(k));
---

<nav class="rail" aria-label="Chapters">
  <ol>
    {
      CHAPTER_ORDER.map((kind) => {
        const chapter = byKind.get(kind);
        return chapter ? (
          <li><a href={`#${chapter.anchor}`}>{LABELS[kind]}</a></li>
        ) : (
          <li class="absent"><span>{LABELS[kind]}</span></li>
        );
      })
    }
  </ol>
  {missing.length > 0 && <p class="rail-note">{missing.length} of {CHAPTER_ORDER.length} chapters still to write.</p>}
</nav>

<style>
  .rail {
    margin: 0 0 2.5rem;
    padding: 1rem 0;
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
  }
  .rail ol {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
    font-family: var(--mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .rail a {
    color: var(--ink);
    text-decoration: none;
    border-bottom: 1px solid var(--rule);
  }
  .rail a:hover {
    color: var(--marker);
    border-bottom-color: currentColor;
  }
  /* Muted, never the rule colour: rule on paper measures 1.3:1 and would fail
     contrast for anything carrying text. */
  .rail .absent span {
    color: var(--muted);
    text-decoration: line-through;
  }
  .rail-note {
    font-family: var(--mono);
    font-size: 0.7rem;
    letter-spacing: 0.04em;
    color: var(--muted);
    margin: 0.75rem 0 0;
    max-width: none;
  }
</style>
