---
// The chapter index for a study. Chapters that do not exist yet are shown
// struck through rather than hidden, which is the honest version: a reader can
// see the shape of a finished study and see what this one is still missing,
// and Matt can ship a project before every chapter is written.
import { CHAPTER_ORDER } from "../schemas.mjs";

const LABELS = {
  final: "Final",
  brief: "Brief",
  boards: "Boards",
  frames: "Styleframes",
  build: "Build",
  delivery: "Delivery",
};

interface Props {
  present: { kind: string; title: string; anchor: string }[];
}

const { present } = Astro.props;
const byKind = new Map(present.map((c) => [c.kind, c]));
const missing = CHAPTER_ORDER.filter((k) => !byKind.has(k));
---

<nav class="rail" aria-label="Chapters">
  <ol>
    {
      CHAPTER_ORDER.map((kind) => {
        const chapter = byKind.get(kind);
        return chapter ? (
          <li><a href={`#${chapter.anchor}`}>{LABELS[kind]}</a></li>
        ) : (
          <li class="absent"><span>{LABELS[kind]}</span></li>
        );
      })
    }
  </ol>
  {missing.length > 0 && present.length > 0 && <p class="rail-note">{missing.length} of {CHAPTER_ORDER.length} chapters still to write.</p>}
  {present.length === 0 && <p class="rail-note">Study in progress.</p>}
</nav>

<script>
  // The mark moves because the reader did. It is the only part of the rail
  // that changes, so it is the only part that needs watching. Without this
  // script the strip is a plain list of anchors, which is the same page minus
  // one line. Motion: --t-slide on --ease-out, which is a cut under reduce.
  const rail = document.querySelector<HTMLElement>("nav.rail");
  if (rail && "IntersectionObserver" in window) {
    const links = Array.from(rail.querySelectorAll<HTMLAnchorElement>('a[href^="#"]'));
    const targets = links.map((a) => document.getElementById(a.getAttribute("href")!.slice(1)));
    const place = (a: HTMLAnchorElement) => {
      for (const l of links) {
        if (l === a) l.setAttribute("aria-current", "location");
        else l.removeAttribute("aria-current");
      }
      const r = a.getBoundingClientRect();
      const n = rail.getBoundingClientRect();
      rail.style.setProperty("--mark-x", `${r.left - n.left}px`);
      rail.style.setProperty("--mark-y", `${r.bottom - n.top}px`);
      rail.style.setProperty("--mark-w", `${r.width}px`);
      rail.classList.add("has-mark");
    };
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (!e.isIntersecting) continue;
          const i = targets.indexOf(e.target as HTMLElement);
          if (i >= 0) place(links[i]);
        }
      },
      { rootMargin: "0px 0px -60% 0px" },
    );
    for (const t of targets) if (t) io.observe(t);
    addEventListener("resize", () => {
      const current = rail.querySelector<HTMLAnchorElement>('a[aria-current="location"]');
      if (current) place(current);
    });
  }
</script>

<style>
  .rail {
    position: relative;
    margin: 0 0 2.5rem;
    padding: 1rem 0;
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
  }
  /* The active mark. One element, moved with a transform, so the transition
     is a composite rather than a reflow. --t-slide is 0ms under reduce. */
  .rail.has-mark::after {
    content: "";
    position: absolute;
    left: 0;
    top: 0;
    height: 2px;
    width: var(--mark-w, 0px);
    background: var(--marker);
    transform: translate(var(--mark-x, 0px), calc(var(--mark-y, 0px) - 1px));
    transition:
      transform var(--t-slide) var(--ease-out),
      width var(--t-slide) var(--ease-out);
    pointer-events: none;
  }
  .rail a[aria-current="location"] {
    color: var(--marker);
    border-bottom-color: transparent;
  }
  .rail ol {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
    font-family: var(--mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .rail a {
    color: var(--ink);
    text-decoration: none;
    border-bottom: 1px solid var(--rule);
  }
  .rail a:hover {
    color: var(--marker);
    border-bottom-color: currentColor;
    transition: color var(--t-quick) var(--ease-out);
  }
  /* Muted, never the rule colour: rule on paper measures 1.3:1 and would fail
     contrast for anything carrying text. */
  .rail .absent span {
    color: var(--muted);
    text-decoration: line-through;
  }
  .rail-note {
    font-family: var(--mono);
    font-size: 0.7rem;
    letter-spacing: 0.04em;
    color: var(--muted);
    margin: 0.75rem 0 0;
    max-width: none;
  }
</style>
