---
import { Font } from "astro:assets";
import { site } from "../site.config.mjs";
import { build } from "../buildstamp.mjs";
import Preferences from "../components/Preferences.astro";
import "../styles/tokens.css";

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;
const pageTitle = title ? `${title} · ${site.name}` : `${site.name}, ${site.hero.replace(/\.$/, "")}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    {/* The one script that runs before paint, and the only inline one on the
        site: a stored theme or motion choice is stamped on the root here so
        the first frame is already right. try/catch wrapped, and a blocked
        storage API leaves the system setting. ADR-0013.

        Wire mode rides along because it also has to be stamped before paint,
        or the masked boxes would flash in on a page a visitor never asked for.
        It is a session key rather than a stored one, so it dies with the tab
        and can never be a visitor's default, and it is read from the URL so
        it survives clicking from the home page into a study. ADR-0014. */}
    <script is:inline>
      try {
        var t = localStorage.getItem("theme");
        if (t === "light" || t === "dark") document.documentElement.setAttribute("data-theme", t);
        var m = localStorage.getItem("motion");
        if (m === "reduce") document.documentElement.setAttribute("data-motion", m);
        var q = location.search;
        if (q.indexOf("nowire") > -1) sessionStorage.removeItem("wire");
        else if (q.indexOf("wire") > -1) sessionStorage.setItem("wire", "1");
        if (sessionStorage.getItem("wire")) document.documentElement.setAttribute("data-wire", "on");
      } catch (e) {}
    </script>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{pageTitle}</title>
    <meta name="description" content={description ?? site.sub} />
    <link rel="canonical" href={Astro.url} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description ?? site.sub} />
    {/* The display face sets the headline, which is the largest paint on every
        page, so it is the one worth a preload. The reading face is preloaded
        roman-only, keeping the italic off the critical path. The mono is small
        and never in the first paint, so it is not preloaded at all. */}
    <Font cssVariable="--font-display" preload />
    <Font cssVariable="--font-body" preload={[{ style: "normal" }]} />
    <Font cssVariable="--font-mono" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="top">
      <a class="name" href="/">{site.name}</a>
      <nav aria-label="Primary">
        <a href="/#builds">Builds</a>
        <a href="/#work">Work</a>
        <a href="/#writing">Writing</a>
        <a href="/#about">About</a>
        <a href="/system">System</a>
      </nav>
      {
        build.sha && (
          <a class="stamp" href={build.href} title={`Built from commit ${build.sha} on ${build.date}`}>
            {build.sha}
          </a>
        )
      }
    </header>
    <div class="wirebar">
      <span>Wireframe. Masked boxes stand where a record is still missing.</span>
      <a href="/wire">Slot inventory</a>
      <a href="?nowire">Turn off</a>
    </div>
    <main id="main">
      <slot />
    </main>
    <footer class="foot">
      <p>
        <a href={site.github}>GitHub</a>
        <span aria-hidden="true">·</span>
        <span>{site.location}</span>
      </p>
      <Preferences />
      <p class="colophon">
        Set in Archivo, Source Serif 4 and IBM Plex Mono, self-hosted. Built static with Astro.
        {build.sha && <> Deployed from <a href={build.href}>{build.sha}</a> on {build.date}.</>}
      </p>
    </footer>
  </body>
</html>

<style is:global>
  /* ---- Tokens -------------------------------------------------------------
     Every colour, space and duration comes from data/design/tokens.json,
     rendered to src/styles/tokens.css by tools/tokens.mjs and imported above.
     The contrast ratios are computed there, and tools/check_tokens.mjs fails
     CI when the CSS is stale, a text pair falls under 4.5 to 1, or a component
     writes a hex, a millisecond or a curve by hand. ADR-0012.

     The font variables stay here because they wrap the ones Astro generates:
     those already carry the metric-matched local fallback and the stack from
     astro.config.mjs, so the value inside var() is only for the case where the
     font CSS never loaded at all. */
  :root {
    --display: var(--font-display, "Helvetica Neue", Arial, sans-serif);
    --body: var(--font-body, Georgia, "Times New Roman", serif);
    --mono: var(--font-mono, ui-monospace, SFMono-Regular, Menlo, monospace);
  }

  /* ---- Base --------------------------------------------------------------- */
  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }
  html {
    background: var(--paper);
    color: var(--ink);
    font-family: var(--body);
    font-size: 17px;
    line-height: 1.55;
    -webkit-text-size-adjust: 100%;
  }
  body {
    background: var(--paper);
    margin: 0;
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
  }
  img,
  video,
  svg {
    display: block;
    max-width: 100%;
    height: auto;
  }
  a {
    color: inherit;
    text-decoration-thickness: 0.06em;
    text-underline-offset: 0.15em;
  }
  a:hover {
    color: var(--marker);
  }
  :focus-visible {
    outline: 2px solid var(--marker);
    outline-offset: 3px;
  }
  /* On a plate the light marker measures 3.2 to 1 and fails, so the ring
     switches to the plate's own marker with a paper halo inside it. The ring
     never animates: a focus ring that fades in arrives late for the one
     person who can least afford the wait. */
  .frame :focus-visible,
  .plate :focus-visible {
    outline-color: var(--plate-marker);
    box-shadow: 0 0 0 2px var(--paper);
  }
  h1,
  h2,
  h3 {
    font-family: var(--display);
    font-weight: 600;
    margin: 0 0 0.5em;
    text-wrap: balance;
  }
  h1 {
    /* The width axis is the point of Archivo here: condensed for the headline,
       normal everywhere else. */
    font-stretch: 80%;
    font-size: clamp(2.5rem, 6vw, 5rem);
    line-height: 0.95;
    letter-spacing: -0.02em;
  }
  h2 {
    font-size: clamp(1.35rem, 2.2vw, 1.6rem);
    line-height: 1.15;
    letter-spacing: -0.015em;
    margin-top: 0;
  }
  h3 {
    font-size: 1.1rem;
    line-height: 1.2;
    letter-spacing: -0.01em;
  }
  p {
    margin: 0 0 1em;
    max-width: var(--measure);
  }
  code,
  kbd,
  samp {
    font-family: var(--mono);
    font-size: 0.85em;
  }

  /* ---- Page frame ---------------------------------------------------------
     One grid carries the whole page: twelve columns capped at --content-max,
     with a full-bleed track on each side. A plate that must run edge to edge
     takes grid-column: full instead of a negative-margin breakout, which is
     what used to overflow the body on narrow viewports. */
  main {
    flex: 1;
    display: grid;
    grid-template-columns:
      [full-start] minmax(var(--gutter), 1fr)
      [content-start] repeat(12, minmax(0, calc((var(--content-max) - 11 * var(--grid-gap)) / 12)))
      [content-end] minmax(var(--gutter), 1fr)
      [full-end];
    column-gap: var(--grid-gap);
    align-content: start;
    padding-bottom: 4rem;
  }
  main > * {
    grid-column: content;
  }
  main > .bleed {
    grid-column: full;
  }

  /* The masthead and footer sit outside the grid but share its measure: their
     max-width includes the gutters, so their inner edge lands on the content
     columns at every width. */
  .top,
  .foot {
    width: 100%;
    max-width: calc(var(--content-max) + 2 * var(--gutter));
    margin: 0 auto;
    padding-left: var(--gutter);
    padding-right: var(--gutter);
  }
  .skip {
    position: absolute;
    left: -999px;
    top: 0;
    background: var(--ink);
    color: var(--paper);
    padding: 0.5rem 1rem;
  }
  .skip:focus {
    left: var(--gutter);
    z-index: 10;
  }

  /* ---- Masthead -----------------------------------------------------------
     Fixed line-height and no wrapping: the header's height is decided before
     any font arrives, so it cannot resize the page underneath the reader. */
  .top {
    display: flex;
    flex-wrap: nowrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 1.5rem;
    padding-top: 1.25rem;
    padding-bottom: 1.25rem;
    line-height: 1;
    border-bottom: 1px solid var(--rule);
  }
  .top .name {
    font-family: var(--display);
    font-weight: 600;
    font-size: 0.95rem;
    letter-spacing: -0.01em;
    text-decoration: none;
    white-space: nowrap;
  }
  .top nav {
    display: flex;
    flex-wrap: nowrap;
    gap: clamp(0.75rem, 3vw, 1.75rem);
    margin-left: auto;
  }
  .top nav a,
  .top .stamp {
    font-family: var(--mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
    text-decoration: none;
    white-space: nowrap;
  }
  .top nav a:hover,
  .top .stamp:hover {
    color: var(--marker);
  }
  .top .stamp {
    text-transform: none;
    letter-spacing: 0.04em;
  }
  /* Below 40rem the name and four nav words do not fit on one line, and they
     were running into the right gutter. Two explicit rows rather than a wrap:
     the header's height is then the same on every load, which is the whole
     reason the nav does not wrap in the first place. */
  @media (max-width: 40rem) {
    .top {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.7rem;
    }
    .top nav {
      margin-left: 0;
      gap: 1.25rem;
    }
    .top .stamp {
      display: none;
    }
  }

  /* ---- Sections ----------------------------------------------------------- */
  section {
    padding: 3.5rem 0 0;
  }
  section > h2 {
    padding-top: 1rem;
    border-top: 1px solid var(--rule);
    margin-bottom: 1.25rem;
  }
  .hero {
    padding: 4.5rem 0 3.5rem;
  }
  .hero h1 {
    max-width: min(100%, 15ch);
    margin-bottom: 0.35em;
  }
  .hero .sub {
    font-size: clamp(1.05rem, 1.8vw, 1.25rem);
    color: var(--muted);
    max-width: min(100%, 46ch);
  }
  /* Wide enough for two columns, the thesis takes the left seven and the deck
     sits in the right margin rather than under it, so the first screen is a
     composition instead of a headline with empty space beside it. The columns
     line up with the page grid because they are the same twelve. */
  @media (min-width: 64rem) {
    .hero {
      display: grid;
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--grid-gap);
      align-items: start;
    }
    .hero h1 {
      grid-column: 1 / span 7;
      max-width: none;
    }
    .hero .sub {
      grid-column: 8 / -1;
      max-width: none;
      margin-top: 0.75rem;
    }
  }
  .pending {
    max-width: var(--measure);
    color: var(--muted);
  }
  .lede {
    color: var(--muted);
    max-width: 58ch;
    margin-bottom: 1.75rem;
  }

  /* ---- The index ----------------------------------------------------------
     Builds and writing are rows, not cards: one rule between entries, the
     title in the display face, the metadata in mono on the right. The same row
     grammar carries both, so a build and a post read as the same kind of
     object and neither looks like a promoted tile. */
  .cards {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--rule);
  }
  .cards > li {
    border-bottom: 1px solid var(--rule);
  }
  .card {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: baseline;
    column-gap: var(--grid-gap);
    padding: 1.1rem 0;
    text-decoration: none;
    transition: background-color var(--t-quick) var(--ease-out);
  }
  a.card:hover {
    background: var(--field);
    color: inherit;
  }
  .card h3 {
    margin: 0 0 0.3em;
  }
  a.card:hover h3 {
    color: var(--marker);
  }
  .card p {
    color: var(--muted);
    margin: 0;
    font-size: 0.95rem;
    grid-column: 1;
    max-width: 62ch;
  }
  .card .meta,
  .meta {
    font-family: var(--mono);
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }
  .card .meta {
    grid-column: 2;
    grid-row: 1;
    text-align: right;
    white-space: nowrap;
  }
  @media (max-width: 34rem) {
    .card {
      grid-template-columns: minmax(0, 1fr);
    }
    .card .meta {
      grid-column: 1;
      grid-row: auto;
      text-align: left;
      padding-top: 0.5rem;
    }
  }

  /* Work is the exception, because a poster is the row's content rather than a
     decoration on it. Two columns, and the still carries its own aspect ratio
     so nothing shifts while it decodes. */
  .cards.work-index {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 22rem), 1fr));
    gap: 2.5rem var(--grid-gap);
    border-top: 0;
  }
  .cards.work-index > li {
    border-bottom: 0;
  }
  .card.work {
    display: block;
    padding: 0;
  }
  .card.work img {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    background: var(--field);
  }
  .card.work:hover {
    background: none;
  }
  .card.work .body {
    padding: 0.9rem 0 0;
  }
  .card.work .meta {
    display: block;
    text-align: left;
    white-space: normal;
    padding-top: 0.4rem;
  }

  /* ---- Study pages -------------------------------------------------------- */
  .facts {
    display: grid;
    grid-template-columns: max-content minmax(0, 1fr);
    gap: 0.4rem 1.5rem;
    margin: 0 0 2.5rem;
    padding: 1rem 0 0;
    border-top: 1px solid var(--rule);
    font-size: 0.95rem;
  }
  .facts dt {
    font-family: var(--mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
    padding-top: 0.25em;
  }
  .facts dd {
    margin: 0;
  }
  .prose {
    max-width: var(--measure);
  }
  .prose h2 {
    font-size: 1.25rem;
    margin-top: 2.5rem;
    border-top: 0;
    padding-top: 0;
  }
  .frame {
    margin: 0 0 2.5rem;
    background: var(--plate);
    overflow: hidden;
  }
  .frame img,
  .frame video {
    width: 100%;
  }
  .frame figcaption {
    font-family: var(--mono);
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    color: var(--plate-muted);
    padding: 0.75rem 1rem;
  }
  .grid {
    display: grid;
    gap: var(--grid-gap);
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 16rem), 1fr));
    margin: 0 0 2.5rem;
    padding: 0;
    list-style: none;
  }
  .grid figcaption {
    font-family: var(--mono);
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    color: var(--muted);
    padding: 0.5rem 0;
  }
  .back {
    display: inline-block;
    margin: 1.5rem 0 2rem;
    font-family: var(--mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
    text-decoration: none;
  }
  .back:hover {
    color: var(--marker);
  }

  /* ---- Footer ------------------------------------------------------------- */
  .foot {
    padding-top: 2rem;
    padding-bottom: 3rem;
    color: var(--muted);
    font-size: 0.85rem;
    border-top: 1px solid var(--rule);
  }
  .foot p {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin: 0;
    max-width: none;
  }
  .foot .colophon {
    display: block;
    font-family: var(--mono);
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    margin-top: 0.75rem;
    max-width: 70ch;
  }



  /* ---- Wire mode ----------------------------------------------------------
     A mask is what renders where a record is missing. It is display:none on
     the live site, so a visitor never sees scaffolding and the public page is
     byte-identical to what it was, and it is the whole page in wire mode. The
     boxes go away one at a time as records land, which is why the wireframe
     cannot drift from the site: it is the site. ADR-0014. */
  .mask,
  .wirebar,
  .wire-only {
    display: none;
  }
  /* display has no "put it back" keyword that respects author rules, so the
     handful of element types that carry wire-only say what they are. */
  :root[data-wire] li.wire-only {
    display: list-item;
  }
  :root[data-wire] ul.wire-only {
    display: grid;
  }
  :root[data-wire] p.wire-only,
  :root[data-wire] div.wire-only,
  :root[data-wire] section.wire-only {
    display: block;
  }
  :root[data-wire] .live-only {
    display: none;
  }
  :root[data-wire] .mask {
    display: block;
    position: relative;
    background: var(--field);
    border: 1px solid var(--rule);
    /* The hatch reads as drafting paper rather than as a broken image, and it
       is the one place a decorative rule-on-field contrast is fine, because it
       never carries text. */
    background-image: repeating-linear-gradient(
      45deg,
      transparent 0 7px,
      color-mix(in srgb, var(--rule) 60%, transparent) 7px 8px
    );
  }
  :root[data-wire] .mask-media {
    display: grid;
    align-content: center;
    justify-items: start;
    gap: 0.35rem;
    padding: var(--grid-gap);
  }
  :root[data-wire] .mask-text {
    padding: 0.75rem 1rem 1rem;
  }
  .mask-label,
  .mask-need {
    font-family: var(--mono);
    font-size: 0.7rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    display: block;
  }
  .mask-label {
    color: var(--ink);
  }
  /* Marker, because this line is the one Matt has to act on. */
  .mask-need {
    color: var(--marker);
    text-transform: none;
    letter-spacing: 0.02em;
  }
  /* Rules at the real line height and measure. Never words: lorem makes a
     wireframe look finished, and looking finished is the one thing it must
     not do. */
  .mask-lines {
    display: grid;
    gap: calc(1.7em - 2px);
    margin-top: 0.9rem;
  }
  .mask-lines span {
    height: 2px;
    background: color-mix(in srgb, var(--rule) 85%, transparent);
  }
  :root[data-wire] .wirebar {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem 1.25rem;
    padding: 0.6rem var(--gutter);
    border-bottom: 1px solid var(--rule);
    background: var(--field);
    font-family: var(--mono);
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    color: var(--muted);
  }
  .wirebar a {
    color: var(--marker);
  }

  /* ---- Misregistration ----------------------------------------------------
     A press out of register prints the plates a hair apart and leaves a
     coloured fringe beside the type. Pointing at a word slides its ghost off
     the true impression, one word at a time, so the page answers where the
     eye is rather than everywhere at once.

     The ghost sits under the word rather than over it, so the reading copy
     stays crisp and the fringe reads as a printing fault rather than as a
     second label. The offset takes --t-slide, a cut under reduce, and the
     tint takes --t-fade, because opacity is not the part that makes anyone
     ill. */
  .slip .w {
    position: relative;
    display: inline-block;
  }
  .slip .ghost {
    position: absolute;
    inset: 0;
    z-index: -1;
    color: var(--marker);
    opacity: 0;
    transform: translateX(0);
    pointer-events: none;
    user-select: none;
    transition:
      transform var(--t-slide) var(--ease-out),
      opacity var(--t-fade) var(--ease-out);
  }
  .slip .w:hover .ghost {
    opacity: 1;
    transform: translateX(0.16em);
  }
  /* A keyboard visitor never hovers, so the whole row registers off at once
     when the link that holds it takes focus. */
  a:focus-visible .slip .ghost {
    opacity: 1;
    transform: translateX(0.16em);
  }

  /* ---- A1, the hero arrives ----------------------------------------------
     Eight pixels and an opacity ramp on first paint, the sub a beat behind.
     It runs once, on load, never on scroll, and --t-fade is 160ms in both
     columns because a fade is not the movement reduce is protecting against.
     The h1 is the largest paint on the page, so this is the one animation
     allowed to touch it. */
  .hero h1,
  .hero .sub {
    animation: hero-rise var(--t-fade) var(--ease-out) both;
  }
  .hero .sub {
    animation-delay: var(--t-quick);
  }
  @keyframes hero-rise {
    from {
      opacity: 0;
      transform: translateY(0.5rem);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  /* ---- B1, the press ------------------------------------------------------
     The tile acknowledges the press and nothing else. It is the part people
     actually notice and it costs one transform on a composited layer. */
  a.card:active {
    transform: scale(0.995);
  }
  .card.work img,
  .card.work .mask {
    transition: transform var(--t-quick) var(--ease-out);
  }
  a.card.work:active img,
  a.card.work:active .mask {
    transform: scale(0.99);
  }
</style>
