# The private half of the search. Never committed.
data/local/

# Python
__pycache__/
*.pyc

# The local staging folder for drops: stills, boards, finals, exports.
# pipeline ingest reads from it. Git never sees it. Root-anchored on purpose:
# a bare "assets/" would also match data/projects/<slug>/assets/, where every
# poster, board and styleframe the site renders is meant to live.
/assets/
setup.log

# Database files never belong in git, and a backup that lands in the repo
# root by mistake must not be one commit away from public.
*.db
postings-*.db
